# ── App (required) ───────────────────────────────────────────────────
# The showcase app only needs read access to fetch published content.
FORME_DELIVERY_URL=https://delivery.forme.sh
FORME_READ_KEY=ce_read_...

# ── Seed script only (not needed to run the app) ────────────────────
# These are only used by `pnpm seed` to create content models and entries.
# You can omit them if your workspace is already seeded.
# FORME_MANAGEMENT_URL=https://management.forme.sh
# FORME_SECRET_KEY=ce_secret_...
